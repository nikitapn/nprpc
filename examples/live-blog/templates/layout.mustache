<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{page_title}} — Live Blog</title>
  <link rel="stylesheet" href="/app.css" />
  <script src="/vendor/htmx.min.js" defer></script>
  <!-- Chat and video islands. Module scripts defer by default, so this runs
       after htmx has installed its event handlers. -->
  <script type="module" src="/islands.js"></script>
</head>
<body>
  <div class="min-h-screen px-4 py-6 md:px-8 md:py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-6">
      <header class="glass-card flex flex-col gap-4 px-6 py-5 md:flex-row md:items-center md:justify-between">
        <div>
          <a href="/" class="text-2xl font-semibold tracking-tight text-stone-950">Live Blog</a>
          <p class="mt-1 text-sm text-stone-600">
            Rendered by the NPRPC backend. Streams stay on the typed client.
          </p>
        </div>
        <nav class="flex flex-wrap gap-2 text-sm font-medium text-stone-700">
          {{#nav}}
          <a class="rounded-full border border-amber-900/15 px-4 py-2 hover:bg-white/70"
             href="{{href}}">{{label}}</a>
          {{/nav}}
        </nav>
      </header>

      <main>{{{content}}}</main>
    </div>
  </div>
</body>
</html>
