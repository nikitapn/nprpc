{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"types": ["vite/client"]
	},
	// noUnusedLocals / noUnusedParameters are deliberately off: src/rpc is
	// generated by npidl and would trip them on every regeneration.
	"include": ["src/**/*.ts"]
}
