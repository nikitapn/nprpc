@PACKAGE_INIT@

# nprpc CMake package configuration file

include(CMakeFindDependencyMacro)

# Find required dependencies: every target nprpc::nprpc links to must exist.
find_dependency(Threads)
find_dependency(Boost)
set(_nprpc_need_uring @NPRPC_ENABLE_TCP@)
if(_nprpc_need_uring)
  find_dependency(PkgConfig)
  pkg_check_modules(uring REQUIRED IMPORTED_TARGET liburing)
endif()
set(_nprpc_need_openssl @NPRPC_NEED_OPENSSL@)
if(_nprpc_need_openssl)
  find_dependency(OpenSSL)
endif()

# A static libnprpc still needs MsQuic at link time; it is installed with
# NPRPC, under share/msquic. A shared libnprpc finds libmsquic by itself.
set(_nprpc_need_msquic @NPRPC_ENABLE_QUIC@)
set(_nprpc_shared @BUILD_SHARED_LIBS@)
if(_nprpc_need_msquic AND NOT _nprpc_shared)
  find_dependency(msquic CONFIG HINTS "${PACKAGE_PREFIX_DIR}/share/msquic")
endif()

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/nprpcTargets.cmake")

# Include npidl.cmake for users who want to generate IDL files
include("${CMAKE_CURRENT_LIST_DIR}/npidl.cmake")

check_required_components(nprpc)

# Provide information about the package
set(NPRPC_VERSION @PROJECT_VERSION@)
set(NPRPC_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# Set convenience variables
if(TARGET nprpc::nprpc)
  set(NPRPC_LIBRARIES nprpc::nprpc)
  set(NPRPC_FOUND TRUE)
endif()
